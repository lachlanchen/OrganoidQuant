{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_tif",
    "date_label",
    "day_rank",
    "stage_label",
    "signal_mode",
    "clahe_clip_limit",
    "foreground_blur_kernel_px",
    "background_blur_kernel_px",
    "threshold_mode",
    "adaptive_block_size_px",
    "adaptive_c_offset",
    "open_kernel_px",
    "close_kernel_px",
    "distance_threshold_fraction_0_to_1",
    "dilate_iterations",
    "min_seed_area_px",
    "min_area_px",
    "max_area_fraction_0_to_1",
    "droplet_reject_circularity_min_0_to_1",
    "droplet_reject_dark_fraction_max_0_to_1",
    "parameter_rationale",
    "confidence_0_to_1"
  ],
  "properties": {
    "source_tif": { "type": "string" },
    "date_label": { "type": "string" },
    "day_rank": { "type": "integer", "minimum": 1, "maximum": 7 },
    "stage_label": { "type": "string", "enum": ["cluster", "cystic", "differentiated_colon_like"] },
    "signal_mode": { "type": "string", "enum": ["gray_inv", "residual", "hybrid"] },
    "clahe_clip_limit": { "type": "number", "minimum": 0.5, "maximum": 6.0 },
    "foreground_blur_kernel_px": { "type": "integer", "minimum": 1, "maximum": 31 },
    "background_blur_kernel_px": { "type": "integer", "minimum": 9, "maximum": 151 },
    "threshold_mode": { "type": "string", "enum": ["otsu", "adaptive_otsu", "hybrid"] },
    "adaptive_block_size_px": { "type": "integer", "minimum": 9, "maximum": 151 },
    "adaptive_c_offset": { "type": "integer", "minimum": -30, "maximum": 30 },
    "open_kernel_px": { "type": "integer", "minimum": 0, "maximum": 25 },
    "close_kernel_px": { "type": "integer", "minimum": 0, "maximum": 35 },
    "distance_threshold_fraction_0_to_1": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
    "dilate_iterations": { "type": "integer", "minimum": 0, "maximum": 10 },
    "min_seed_area_px": { "type": "integer", "minimum": 5, "maximum": 10000 },
    "min_area_px": { "type": "integer", "minimum": 20, "maximum": 50000 },
    "max_area_fraction_0_to_1": { "type": "number", "minimum": 0.05, "maximum": 0.9 },
    "droplet_reject_circularity_min_0_to_1": { "type": "number", "minimum": 0.1, "maximum": 0.99 },
    "droplet_reject_dark_fraction_max_0_to_1": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "parameter_rationale": { "type": "string" },
    "confidence_0_to_1": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  }
}
